# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

# Copy dependency files and install
COPY package*.json ./
RUN npm install

# Create logs directory
RUN mkdir -p /app/Logs

# Stage 2: Runtime (Distroless)
FROM gcr.io/distroless/nodejs20-debian12
WORKDIR /app

# Copy dependencies from build stage
COPY --from=build /app/node_modules ./node_modules

# Copy application code and logs with correct permissions
# Distroless uses 65532:65532 for the 'nonroot' user
COPY --from=build --chown=65532:65532 /app/Logs ./Logs
COPY --chown=65532:65532 server.js ./
COPY --chown=65532:65532 package.json ./

USER 65532
EXPOSE 3000

# Distroless nodejs images use 'node' as the entrypoint; you just provide the file
CMD ["server.js", "development"]

